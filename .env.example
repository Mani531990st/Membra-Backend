# PostgreSQL connection string
# If the password contains @ : / # etc, URL-encode it (e.g. @ → %40, ! → %21).
# Session-cap uses SELECT … FOR UPDATE; use a session-mode URL (not transaction-mode PgBouncer).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE"

# HTTP port (NestJS). Defaults to 3000.
# PORT=3000

# API docs (Swagger UI + OpenAPI JSON). Defaults to on in development.
# In production, set to true to expose /api/docs and /api/openapi.json.
ENABLE_API_DOCS=true

# Public app origin for CORS, CSRF Origin checks, and password-reset links.
APP_BASE_URL=http://localhost:3000
# Extra CORS origins, comma-separated.
# CORS_ORIGINS=http://localhost:5173

# Auth (optional overrides)
# SESSION_COOKIE_NAME=membra_session
# PASSWORD_RESET_TTL_MINUTES=60

# Production requires SMTP_HOST and SMTP_FROM (boot fails closed otherwise).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com


# Scaleway Object Storage (avatars). Region: Amsterdam.
# Local/runtime Object Storage key only — not the GitHub container deploy key.
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_DEFAULT_ORGANIZATION_ID=
SCW_DEFAULT_PROJECT_ID=
SCW_DEFAULT_REGION=nl-ams
SCW_S3_ENDPOINT=https://s3.nl-ams.scw.cloud
SCW_S3_BUCKET=membra-avatars