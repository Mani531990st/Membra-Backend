# PostgreSQL connection string
# If the password contains @ : / # etc, URL-encode it (e.g. @ → %40, ! → %21).
DATABASE_URL="postgresql://postgres:Pass%402025%21@localhost:5432/membra_db_new"

# HTTP port (NestJS). Defaults to 3000.
# PORT=3000

# API docs (Swagger UI + OpenAPI JSON). Defaults to on in development.
# In production, set to true to expose /api/docs and /api/openapi.json.
ENABLE_API_DOCS=true

# Auth (optional overrides)
# SESSION_COOKIE_NAME=membra_session
# SESSION_TTL_DAYS=14
# PASSWORD_RESET_TTL_MINUTES=60
# APP_BASE_URL=http://localhost:3000
