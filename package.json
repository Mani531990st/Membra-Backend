{
  "name": "membra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,scripts}/**/*.{ts,mjs}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed:genders": "tsx scripts/seed-genders.ts",
    "db:seed:activities": "tsx scripts/seed-activities.ts",
    "db:seed:languages": "tsx scripts/seed-languages.ts",
    "db:seed:dev-user": "tsx scripts/seed-dev-user.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "^3.1129.0",
    "@aws-sdk/s3-request-presigner": "^3.1129.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/throttler": "^6.5.0",
    "@node-rs/argon2": "^2.2.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "heic-convert": "^2.1.0",
    "nodemailer": "^10.0.3",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/heic-convert": "^2.1.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.7"
  }
}
